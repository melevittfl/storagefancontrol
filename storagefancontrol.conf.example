[General]
# Polling interval in seconds.
polling_interval = 30

# Temperature in Celcius. Used by the PID controller only.
#
# Set this above what the drives actually reach at full fan speed. If the
# target is unreachable the error never returns to zero, the integrator
# winds up to I_max and the fans sit at 100% indefinitely. Large-scale
# studies (Google, 100k drives) put the lowest failure rates at 37-46C, so
# there is nothing to gain from chasing a lower number.
target_temperature = 40

# Fan speed controller: 'pid' or 'curve'.
# pid:   Feedback controller that targets `target_temperature`.
#        Adapts to ambient conditions but can be noisy when tuned
#        to keep temperatures well below a hard ceiling.
# curve: Piecewise-linear map from drive temperature to fan speed.
#        Predictable and asymmetric — quiet when cool, aggressive
#        only as drives approach the upper limit. See [FanCurve].
controller = pid

[Pid]
# The values in this section are tuned for the author's system.
# They seem sane default values but may require tweaking.

# Proportional: how big the change in percent is when an ajustment is made.
P = 10

# Integral: how much the change will be amplified based on the error.
# where 'error' is the distance from the target temperature.
I = 1

# Derivative: the fan speed will be ajusted by this percent direct after a
# change in temperature, multiplied by the 'error' or distance from the target
# temperature. The value will be zero if there is no change.
D = 1

# When the temperature changes, the initial change will be amplified by D.
# This amplification can be further increased based on the D_aplification
# factor
D_amplification = 0

# I_start determines the fan speed in percent when the script is first started.
I_start = 40

# Determines the minimum and maximum fan speed in percent.
I_max = 100
I_min = 20

[Chassis]
# PWM fan speed range is 1-255.
# To protect against the risk of overheating, make sure that pwm_min is set
# to a value that results in a reasonable airflow.
pwm_min = 20
pwm_max = 64

# This setting should protect the system against overheating if the script
# crashes.
pwm_safety = 32

# Rear fan runs at this fraction of the front fan PWM, floored at pwm_min.
# 1.0 = matches front fans exactly. 0.5 = half speed. Never hands off to BIOS.
rear_fan_ratio = 0.9

# CPU temperature thresholds for rear fan control (read from hwmon sysfs,
# /sys/class/hwmon, via the coretemp driver).
# Below cpu_temp_min the CPU contributes nothing to rear fan speed.
# At cpu_temp_max the CPU drives the rear fan to pwm_max.
# Rear fan always takes the max of the drive-based and CPU-based calculations.
cpu_temp_min = 40
cpu_temp_max = 80

[FanCurve]
# Comma-separated list of temperature:fan_percent points.
# Linear interpolation between adjacent points. Below the lowest
# point and above the highest, fan speed is clamped to that
# endpoint's value.
#
# Keep the steps small around the temperature the drives normally sit at.
# A curve that jumps 25 points for one degree, right where the drives
# idle, makes the fans audibly cycle up and down as the reading crosses
# the boundary. Save the steep part for temperatures that mean something
# is actually wrong.
#
# Below: gentle through the normal 37-39C band, firmer approaching 41C,
# and full speed by 44C.
curve = 34:20, 37:30, 39:45, 41:70, 44:100

[Smart]
# Where drive temperatures come from.
#
# auto      Prefer the drivetemp kernel module, fall back to smartctl.
# drivetemp Kernel module only. Reads over ATA SCT Command Transport, so
#           it works even on drives with SMART switched off, costs no
#           subprocesses, and will not spin up a sleeping drive. This is
#           the same source the TrueNAS dashboard uses from 25.10 on.
#           Load it with 'modprobe drivetemp'.
# smartctl  Run smartctl per drive. Needs SMART enabled on each drive
#           ('smartctl -s on /dev/sdX').
source = auto

# Skip removable-medium devices. The BMC presents virtual floppy, CD and
# USB disks over the IPMI console, and they appear as ordinary sd* devices
# with no media and no temperature. They are not chassis drives, so they
# must not be monitored or advertised over MQTT. Set to false only if you
# genuinely want a removable device included.
exclude_removable = true

# Drives are discovered from /sys/block. Only devices whose name starts
# with device_filter are monitored. On Linux/TrueNAS SCALE, SATA and SAS
# drives are 'sd' (sda, sdb, ...); NVMe drives are 'nvme'.
device_filter = sd

# Boot drive(s) to exclude from monitoring.
#
# 'auto' asks the boot pool which devices it sits on, and is what you
# want. Linux assigns /dev/sd* letters in discovery order, so the boot
# drive is not necessarily sda and can move between boots; a hardcoded
# letter will eventually exclude the wrong disk and monitor the boot
# drive in its place.
#
# To pin it by hand instead, use stable /dev/disk/by-id names, comma
# separated for a mirrored boot pool. List them with:
#   ls -l /dev/disk/by-id/ | grep -v part
# Bare sdX names still work but are not stable across reboots.
boot_device = auto

# How many instances of 'smartctl' are run in parallel when polling for
# the hard drive temperature.
smart_workers = 30

# Seconds to wait for a single smartctl call before giving up on that
# drive. Without this a hung smartctl would stall the control loop.
smartctl_timeout = 30

[MQTT]
enabled = false
broker = 192.168.1.x
port = 1883
username =
password =
# Groups all drive sensors under one device in Home Assistant.
device_id = truenas_temps
device_name = TrueNAS Temperature Logger
